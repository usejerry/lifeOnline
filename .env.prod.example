NODE_ENV=production
PORT=3000

DB_HOST=db
DB_PORT=3306
DB_USER=life_online
DB_PASSWORD=replace_with_a_strong_database_password
DB_DATABASE=life_online
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Set true only for the first start of this demo project, then change to false.
DB_SYNCHRONIZE=true

JWT_SECRET=replace_with_a_random_secret_that_is_at_least_64_characters_long_before_deploying
LOG_ON=true
LOG_LEVEL=info

AMAP_WEB_SERVICE_KEY=

# Use :80 before buying a domain. Later replace it with api.example.com.
SITE_ADDRESS=:80
