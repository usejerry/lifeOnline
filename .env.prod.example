NODE_ENV=production
PORT=3000

DB_HOST=db
DB_PORT=3306
DB_USER=life_online
DB_PASSWORD=replace_with_a_strong_database_password
DB_DATABASE=life_online
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Set true only for initial schema creation, then change it back to false.
DB_SYNCHRONIZE=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password

JWT_SECRET=replace_with_a_random_secret_that_is_at_least_64_characters_long_before_deploying
LOG_ON=true
LOG_LEVEL=info

# Optional AMap server-side key.
AMAP_WEB_SERVICE_KEY=

SITE_ADDRESS=:80
FRONTEND_CONTEXT=../lifeOnline-h5
