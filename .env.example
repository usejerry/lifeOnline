# Local development configuration. Copy this file to .env before starting Nest.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=example
DB_DATABASE=life_online
DB_SYNCHRONIZE=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Development only. Use a randomly generated secret in production.
JWT_SECRET=local-development-only-jwt-secret-change-before-production-0123456789abcdef
LOG_ON=true
LOG_LEVEL=debug

# Optional: required only by the location/map features.
AMAP_WEB_SERVICE_KEY=
